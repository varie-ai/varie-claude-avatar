#!/bin/bash
# install-daemon — Download and install the Varie Claude Avatar daemon
#
# Usage:
#   install-daemon              # Auto-detect platform, install silently
#   install-daemon --verbose    # Show progress output
#
# Called by:
#   - ensure-daemon-running (background, on first session)
#   - /varie-avatar:install skill (interactive)

set -e

REPO="varie-ai/varie-claude-avatar"
STATE_DIR="$HOME/.varie-claude-avatar"
LOCK_FILE="$STATE_DIR/.installing"

VERBOSE=""
if [[ "$1" == "--verbose" ]]; then
  VERBOSE="1"
fi

log() {
  if [[ -n "$VERBOSE" ]]; then
    echo "$@"
  fi
}

# Create state directory
mkdir -p "$STATE_DIR"

# Prevent parallel installs
if [[ -f "$LOCK_FILE" ]]; then
  LOCK_PID=$(cat "$LOCK_FILE" 2>/dev/null)
  if [[ -n "$LOCK_PID" ]] && kill -0 "$LOCK_PID" 2>/dev/null; then
    log "[varie-avatar] Installation already in progress (PID $LOCK_PID)"
    exit 0
  fi
  # Stale lock — remove it
  rm -f "$LOCK_FILE"
fi

echo $$ > "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"' EXIT

# Detect platform and set install path + asset pattern
if [[ "$OSTYPE" == "darwin"* ]]; then
  INSTALL_DIR="$HOME/Applications"
  APP_NAME="Varie Claude Avatar.app"
  ARCH=$(uname -m)
  if [[ "$ARCH" == "arm64" ]]; then
    ASSET_PATTERN="arm64-mac.zip"
  else
    # x86_64 (Intel) — match mac.zip, exclude arm64 variant
    ASSET_PATTERN="mac.zip"
    ASSET_EXCLUDE="arm64"
  fi

  # Check if already installed
  if [[ -d "/Applications/$APP_NAME" ]] || [[ -d "$INSTALL_DIR/$APP_NAME" ]]; then
    log "[varie-avatar] Daemon already installed"
    exit 0
  fi

elif [[ "$OSTYPE" == "msys"* || "$OSTYPE" == "cygwin"* || "$OSTYPE" == "win32"* ]]; then
  INSTALL_DIR="$LOCALAPPDATA/Programs/Varie Claude Avatar"
  ASSET_PATTERN="Setup.*\\.exe"
  if [[ -f "$INSTALL_DIR/Varie Claude Avatar.exe" ]]; then
    log "[varie-avatar] Daemon already installed"
    exit 0
  fi

elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
  INSTALL_DIR="$HOME/.local/bin"
  ASSET_PATTERN="AppImage"
  if [[ -f "$INSTALL_DIR/varie-claude-avatar" ]]; then
    log "[varie-avatar] Daemon already installed"
    exit 0
  fi

else
  log "[varie-avatar] Unsupported platform: $OSTYPE"
  exit 1
fi

mkdir -p "$INSTALL_DIR"

# Fetch latest release asset URL from GitHub API
log "[varie-avatar] Checking latest release..."
RELEASE_JSON=$(curl -sL "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null)

if [[ -z "$RELEASE_JSON" ]]; then
  log "[varie-avatar] Failed to fetch release info"
  exit 1
fi

ASSET_URLS=$(echo "$RELEASE_JSON" | grep -o "\"browser_download_url\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | grep "$ASSET_PATTERN")
if [[ -n "${ASSET_EXCLUDE:-}" ]]; then
  ASSET_URLS=$(echo "$ASSET_URLS" | grep -v "$ASSET_EXCLUDE")
fi
ASSET_URL=$(echo "$ASSET_URLS" | head -1 | grep -o 'https://[^"]*')

if [[ -z "$ASSET_URL" ]]; then
  log "[varie-avatar] No matching release asset found for this platform"
  log "[varie-avatar] Download manually from: https://github.com/$REPO/releases"
  exit 1
fi

VERSION=$(echo "$RELEASE_JSON" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | grep -o '"v[^"]*\|"[0-9][^"]*' | tr -d '"')
log "[varie-avatar] Downloading $VERSION..."

# Download to temp file
TMPFILE=$(mktemp /tmp/varie-avatar-XXXXXX)
HTTP_CODE=$(curl -sL -w "%{http_code}" -o "$TMPFILE" "$ASSET_URL" 2>/dev/null)

if [[ "$HTTP_CODE" != "200" && "$HTTP_CODE" != "302" ]]; then
  rm -f "$TMPFILE"
  log "[varie-avatar] Download failed (HTTP $HTTP_CODE)"
  exit 1
fi

# Install based on platform
if [[ "$OSTYPE" == "darwin"* ]]; then
  log "[varie-avatar] Installing to $INSTALL_DIR..."
  # Remove old version if present in ~/Applications
  rm -rf "$INSTALL_DIR/$APP_NAME"
  unzip -q -o "$TMPFILE" -d "$INSTALL_DIR/"
  rm -f "$TMPFILE"

  # Verify
  if [[ -d "$INSTALL_DIR/$APP_NAME" ]]; then
    log "[varie-avatar] Installed successfully: $INSTALL_DIR/$APP_NAME"
    # Launch immediately so the avatar appears this session
    open -g -j "$INSTALL_DIR/$APP_NAME" &
    log "[varie-avatar] Daemon launched."
  else
    log "[varie-avatar] Installation failed — app not found after extraction"
    exit 1
  fi

elif [[ "$OSTYPE" == "msys"* || "$OSTYPE" == "cygwin"* || "$OSTYPE" == "win32"* ]]; then
  mv "$TMPFILE" "$TMPFILE.exe"
  log "[varie-avatar] Running installer..."
  "$TMPFILE.exe" /S
  rm -f "$TMPFILE.exe"
  log "[varie-avatar] Installed successfully"

elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
  mv "$TMPFILE" "$INSTALL_DIR/varie-claude-avatar"
  chmod +x "$INSTALL_DIR/varie-claude-avatar"
  log "[varie-avatar] Installed successfully: $INSTALL_DIR/varie-claude-avatar"
fi
