#!/bin/bash
# Compatibility wrapper for install-daemon (deprecated: installation now lives
# in the cross-platform Node client at lib/install-daemon.cjs).
#
# Usage:
#   install-daemon            # download and install the daemon silently
#
# Called by:
#   - the /varie-avatar:install skill (interactive)
#   - older setups that still reference this path
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec node "$SCRIPT_DIR/lib/install-daemon.cjs" "$@"
