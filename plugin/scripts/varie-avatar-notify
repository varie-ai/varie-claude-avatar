#!/bin/bash
# varie-avatar-notify - Fire and forget notification to daemon
# Reads hook data from stdin (JSON) and sends to daemon socket

# Debug log
echo "[$(date)] varie-avatar-notify called with: $@" >> /tmp/varie-avatar-debug.log

SOCKET="/tmp/varie-claude-avatar.sock"
[[ ! -S "$SOCKET" ]] && exit 0

# Convert hyphens to underscores for event type
EVENT="${1:-unknown}"
EVENT="${EVENT//-/_}"

# Get project name and full path from current directory
PROJECT="$(basename "$PWD")"
PROJECT_PATH="$PWD"

# Read stdin (hooks provide JSON with tool info)
STDIN_DATA=""
if [[ ! -t 0 ]]; then
  STDIN_DATA=$(cat)
fi

# Debug log stdin
echo "[$(date)] stdin: $STDIN_DATA" >> /tmp/varie-avatar-debug.log

# Get session ID from stdin JSON first (most reliable), then env var, then PID fallback
SID=""
if [[ -n "$STDIN_DATA" ]]; then
  SID=$(echo "$STDIN_DATA" | grep -o '"session_id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
fi
SID="${SID:-${CLAUDE_SESSION_ID:-$$}}"

# Parse tool info from stdin JSON (if available)
TOOL=""
SUMMARY=""
AGENT_TYPE=""
NOTIFICATION_TYPE=""
STDIN_MESSAGE=""
if [[ -n "$STDIN_DATA" ]]; then
  # Extract tool_name from hook input
  TOOL=$(echo "$STDIN_DATA" | grep -o '"tool_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"tool_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

  # Extract agent_type for SubagentStart events
  AGENT_TYPE=$(echo "$STDIN_DATA" | grep -o '"agent_type"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"agent_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

  # Extract notification_type for Notification events
  NOTIFICATION_TYPE=$(echo "$STDIN_DATA" | grep -o '"notification_type"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"notification_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

  # Extract message for Notification events
  STDIN_MESSAGE=$(echo "$STDIN_DATA" | grep -o '"message"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

  # Extract permission_mode - will be "plan" when in plan mode
  PERMISSION_MODE=$(echo "$STDIN_DATA" | grep -o '"permission_mode"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"permission_mode"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

  # Extract command/file info for summary using shared Python module
  # (handles JSON escaping: quoted strings, newlines, backslashes)
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  if [[ "$TOOL" == "Bash" ]]; then
    SUMMARY=$(echo "$STDIN_DATA" | python3 "$SCRIPT_DIR/extract_summary.py" command 2>/dev/null)
    # Fallback: basic grep if python3/module unavailable (loses quoted args)
    if [[ -z "$SUMMARY" ]]; then
      SUMMARY=$(echo "$STDIN_DATA" | grep -o '"command"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"command"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' | cut -c1-150)
    fi
  fi
  # For Write/Edit: get the file path basename
  if [[ "$TOOL" == "Write" || "$TOOL" == "Edit" ]]; then
    SUMMARY=$(echo "$STDIN_DATA" | python3 "$SCRIPT_DIR/extract_summary.py" file_path 2>/dev/null)
    if [[ -z "$SUMMARY" ]]; then
      SUMMARY=$(echo "$STDIN_DATA" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' | xargs basename 2>/dev/null)
    fi
  fi
  # For ExitPlanMode: set summary
  if [[ "$TOOL" == "ExitPlanMode" ]]; then
    TOOL="Plan"
    SUMMARY="Plan requires approval"
  fi
fi

# Handle SubagentStart for Plan mode
if [[ "$EVENT" == "subagent_start" && "$AGENT_TYPE" == "Plan" ]]; then
  # Convert to approval_needed event for Plan mode
  EVENT="approval_needed"
  TOOL="Plan"
  SUMMARY="Entering plan mode"
fi

# Fallback: use --tool argument if provided and stdin didn't have tool
if [[ -z "$TOOL" && "$2" == "--tool" ]]; then
  TOOL="$3"
fi

# Handle --message argument for notification events
MESSAGE=""
if [[ "$2" == "--message" ]]; then
  MESSAGE="$3"
fi

# Use stdin message if --message wasn't provided
if [[ -z "$MESSAGE" && -n "$STDIN_MESSAGE" ]]; then
  MESSAGE="$STDIN_MESSAGE"
fi

# Handle idle_prompt notifications as "attention" type
if [[ "$EVENT" == "notification" && "$NOTIFICATION_TYPE" == "idle_prompt" ]]; then
  EVENT="attention"
  SUMMARY="Claude needs attention!"
fi

# Handle question events (AskUserQuestion tool)
if [[ "$EVENT" == "question" ]]; then
  TOOL="Question"
  SUMMARY="Claude has a question for you"
fi

# Handle plan-complete events (ExitPlanMode PostToolUse)
if [[ "$EVENT" == "plan_complete" ]]; then
  TOOL="Plan"
  SUMMARY="Plan requires approval"
fi

# Handle question-complete events (AskUserQuestion PostToolUse)
if [[ "$EVENT" == "question_complete" ]]; then
  TOOL="Question"
  SUMMARY="Claude has a question for you"
fi

# Escape special chars for JSON
SUMMARY="${SUMMARY//\\/\\\\}"
SUMMARY="${SUMMARY//\"/\\\"}"
SUMMARY="${SUMMARY//$'\n'/\\n}"

# Build JSON
JSON="{\"type\":\"$EVENT\",\"tool\":\"$TOOL\",\"sessionId\":\"$SID\",\"timestamp\":$(date +%s)000,\"metadata\":{\"project\":\"$PROJECT\",\"projectPath\":\"$PROJECT_PATH\",\"summary\":\"$SUMMARY\"}}"

# Write to socket in background subshell, completely detached
# Retry up to 3 times with 0.5s delay — covers socket-not-ready race after daemon launch
(
  exec >/dev/null 2>&1
  for _attempt in 1 2 3; do
    echo "$JSON" | nc -w1 -U "$SOCKET" && break
    sleep 0.5
  done
) </dev/null >/dev/null 2>&1 &

exit 0
